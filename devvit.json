{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "node-games",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Post Today's Schema Crisis",
        "description": "Publish today's daily node-link puzzle challenge",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Post Tomorrow's Schema Crisis",
        "description": "Pre-publish tomorrow's daily node-link puzzle challenge",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-tomorrow"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "node_games_dev"
  }
}